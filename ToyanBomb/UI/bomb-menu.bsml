<vertical spacing="0.8">
  <toggle-setting text="Enabled" value="bomb-enabled" on-change="bomb-enabled-changed" />

  <horizontal spacing="0" preferred-width="70">
    <text text="Bomb Size" preferred-width="25" />
    <slider-setting text=" "
                    value="bomb-size"
                    min="1.0" max="2.5" increment="0.05"
                    on-change="bomb-size-changed"
                    show-buttons="false"
                    size-delta-x="8" />
  </horizontal>

  <horizontal spacing="0" preferred-width="70">
    <text text="Cut Effect" preferred-width="25" />
    <slider-setting text=" "
                    value="cut-effect-percent"
                    min="0" max="400" increment="10"
                    on-change="cut-effect-changed"
                    show-buttons="false"
                    size-delta-x="8" />
  </horizontal>

  <horizontal spacing="0" preferred-width="70">
    <text text="!bomb Text/Stamp" preferred-width="25" />
    <slider-setting text=" "
                    value="custom-visual-size"
                    min="25" max="300" increment="5"
                    on-change="custom-visual-size-changed"
                    show-buttons="false"
                    size-delta-x="8" />
  </horizontal>

  <horizontal spacing="0" preferred-width="70">
    <text text="!bomb Name" preferred-width="25" />
    <slider-setting text=" "
                    value="bomb-name-size"
                    min="25" max="300" increment="5"
                    on-change="bomb-name-size-changed"
                    show-buttons="false"
                    size-delta-x="8" />
  </horizontal>


  <horizontal spacing="0" preferred-width="70">
    <text text="Display Time" preferred-width="25" />
    <slider-setting text=" " value="display-time" min="1.0" max="6.0" increment="0.1" on-change="display-time-changed" show-buttons="false" size-delta-x="8" />
  </horizontal>

  <horizontal spacing="0" preferred-width="70">
    <text text="Display Distance" preferred-width="25" />
    <slider-setting text=" " value="display-distance" min="1.0" max="10.0" increment="0.1" on-change="display-distance-changed" show-buttons="false" size-delta-x="8" />
  </horizontal>

  <horizontal spacing="0" preferred-width="70">
    <text text="Display Height" preferred-width="25" />
    <slider-setting text=" " value="display-height" min="-1.0" max="1.0" increment="0.05" on-change="display-height-changed" show-buttons="false" size-delta-x="8" />
  </horizontal>

  <horizontal spacing="0" preferred-width="70">
    <text text="Fly Speed" preferred-width="25" />
    <slider-setting text=" " value="fly-speed" min="1" max="10" increment="1" on-change="fly-speed-changed" show-buttons="false" size-delta-x="8" />
  </horizontal>

  <horizontal spacing="0" preferred-width="70">
    <text text="Float Speed" preferred-width="25" />
    <slider-setting text=" " value="float-speed" min="0" max="0.5" increment="0.01" on-change="float-speed-changed" show-buttons="false" size-delta-x="8" />
  </horizontal>

  <horizontal spacing="0" preferred-width="70">
    <text text="Fade Speed" preferred-width="25" />
    <slider-setting text=" " value="fade-speed" min="1" max="10" increment="1" on-change="fade-speed-changed" show-buttons="false" size-delta-x="8" />
  </horizontal>

  <horizontal spacing="1" preferred-width="70">
    <text text="Total Bombs" preferred-width="25" />
    <button text="Reset Count" on-click="reset-total-bombs" />
  </horizontal>
</vertical>
